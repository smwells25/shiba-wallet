{
  "name": "shiba-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "Non-custodial mobile cryptocurrency wallet with Account Abstraction as a core feature",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @shiba-wallet/core && npm run build --workspaces --if-present",
    "test": "node scripts/ci/run.mjs --mode offline",
    "test:live": "node scripts/ci/run.mjs --mode live",
    "test:engine": "node scripts/ci/run.mjs --only engine",
    "test:app": "node scripts/ci/run.mjs --only app",
    "lint": "node scripts/ci/run.mjs --only lint",
    "typecheck": "node scripts/ci/run.mjs --only typecheck",
    "bundle": "node scripts/ci/run.mjs --only bundle",
    "secret-scan": "node scripts/githooks/secret-scan.mjs --tree HEAD",
    "hooks:install": "git config core.hooksPath scripts/githooks"
  }
}
